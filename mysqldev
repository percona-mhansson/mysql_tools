#!/usr/bin/env bash

SCRIPT_DIR=$(dirname "$0")
REQUIREMENTS="$SCRIPT_DIR/python/requirements.txt"

# This checkout is shared between containers running different OS versions, and
# a venv only works with the Python version that created it, so keep one venv
# per Python version.
PY_VERSION=$(python3 -c 'import sys; print(f"{sys.version_info[0]}.{sys.version_info[1]}")') || {
  echo "mysqldev: python3 not found" >&2
  exit 1
}
VENV_DIR="$SCRIPT_DIR/python/venv-$PY_VERSION"
PYTHON="$VENV_DIR/bin/python3"
# Copy of the requirements file that was last installed into the venv.
STAMP="$VENV_DIR/.requirements.installed"

if ! "$PYTHON" -c '' 2>/dev/null; then
  echo "mysqldev: setting up Python $PY_VERSION venv in $VENV_DIR" >&2
  rm -rf "$VENV_DIR"
  python3 -m venv "$VENV_DIR" || {
    echo "mysqldev: failed to create venv (is python$PY_VERSION-venv installed?)" >&2
    rm -rf "$VENV_DIR"
    exit 1
  }
fi

# Install dependencies whenever requirements.txt has changed since last install.
if ! cmp -s "$REQUIREMENTS" "$STAMP"; then
  echo "mysqldev: installing Python dependencies" >&2
  "$PYTHON" -m pip install --quiet -r "$REQUIREMENTS" || {
    echo "mysqldev: failed to install dependencies from $REQUIREMENTS" >&2
    exit 1
  }
  cp "$REQUIREMENTS" "$STAMP"
fi

"$PYTHON" "$SCRIPT_DIR/python/mysqldev.py" "$@"
